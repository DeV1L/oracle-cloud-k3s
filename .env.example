# Copy this file to .env in the repository root. Replace every placeholder with its value.
# See docs/SETUP.md for where each value comes from.

# OCI Customer Secret Key (for the Pulumi state bucket, S3-compatible API)
export AWS_ACCESS_KEY_ID='<access key>'
export AWS_SECRET_ACCESS_KEY='<secret key>'
export AWS_REGION='<region>'

# Pulumi state backend: the bucket "pulumi-state" in the Object Storage namespace
export PULUMI_BACKEND_URL='s3://pulumi-state?endpoint=https://<namespace>.compat.objectstorage.<region>.oraclecloud.com&region=<region>&s3ForcePathStyle=true'

# Pulumi passphrase: encrypts the secret values in the state
export PULUMI_CONFIG_PASSPHRASE='<passphrase>'

# OCI CLI installed by the Oracle installer
export PATH="$HOME/bin:$PATH"
